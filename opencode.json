{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "mcp": {
    "mongodb": {
      "type": "local",
      "command": ["/Users/guest1/.nvm/current/bin/npx", "-y", "mongodb-mcp-server@latest", "--readOnly"],
      "environment": {
        "PATH": "/Users/guest1/.nvm/current/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin",
        "MDB_MCP_CONNECTION_STRING": "{env:TEDBROKER_MONGODB_URL}",
        "MDB_MCP_TELEMETRY": "disabled"
      },
      "timeout": 60000,
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    }
  }
}
