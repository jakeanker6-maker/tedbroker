# TED Brokers Environment Configuration

# Security
SECRET_KEY=your-secret-key-change-this-in-production-make-it-long-and-random
ACCESS_TOKEN_EXPIRE_MINUTES=30

# MongoDB Configuration
# For local development: mongodb://localhost:27017
# For production: Use MongoDB Atlas or hosted MongoDB service
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=tedbroker

# SendGrid Email Configuration
# Get your API key from: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=your-sendgrid-api-key-here
SENDGRID_FROM_EMAIL=noreply@tedbrokers.com
SENDGRID_FROM_NAME=TED Brokers

# Google OAuth (sign-in with Google). Redirect URI must be registered in the Google Cloud OAuth client.
# Production: https://tedbrokers.com/api/auth/google/callback
# Local: http://localhost:8001/api/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://tedbrokers.com/api/auth/google/callback

# Server Configuration
# Comma-separated site origins allowed to call the API from another host (never *)
CORS_ORIGINS=https://your-site.example
HOST=0.0.0.0
PORT=8001
DEBUG=True

# Smartsupp Integration
SMARTSUPP_API_KEY=your-smartsupp-api-key
SMARTSUPP_ALERT_EMAIL=login-alerts@tedbroker.com

# Cloudflare Turnstile (captcha) for sign-in, sign-up, password reset and 2FA resend.
# Get keys from the Cloudflare dashboard (Turnstile). The secret is server only.
TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key
# Local development only, and only when TURNSTILE_SECRET_KEY is empty: skips the check.
# Without a secret and without this flag, protected endpoints return 503.
CAPTCHA_DISABLED=false
